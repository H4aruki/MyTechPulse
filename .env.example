# docker-compose.yml の変数補間用。ルートに .env としてコピーすると上書きできる。
# 未設定なら compose 内の既定値 postgres が使われる。
# 本番では必ずランダムな値を設定すること:
#   printf 'POSTGRES_PASSWORD=%s\n' "$(python3 -c 'import secrets; print(secrets.token_urlsafe(24))')" > .env
POSTGRES_PASSWORD=postgres

# 本番のみ。caddy が証明書を取得するドメイン。
# `docker compose --profile prod up -d` で caddy を起動する際に必須。
# ローカル開発では caddy を起動しないので未設定でよい。
# API_DOMAIN=api.mytechpulse.net
