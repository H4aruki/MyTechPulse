# docker-compose.yml の変数補間用。ルートに .env としてコピーすると上書きできる（コピーは Git に入れない）。
# ここは、DBのパスワードと、HTTPSの窓口(Caddy)のドメインだけ。
# APIの設定(Qiitaのトークン、許可する画面のURLなど)は、server/.env.example を参照。
#
# 本番は、このファイルを使わない。サーバー上の ~/mytechpulse-production.env に、
# 同じ項目と、APIの設定を、まとめて書く（docs/deploy/lightsail-provisioning.md の7章）。

# DBのパスワード。未設定なら、compose内の既定値 postgres が使われる（ローカル専用）。
# 本番では必ずランダムな値を設定すること:
#   printf 'POSTGRES_PASSWORD=%s\n' "$(openssl rand -base64 24 | tr -d '/+=')" > .env
POSTGRES_PASSWORD=postgres

# 本番のみ。caddy が証明書を取得するドメイン。
# `docker compose --profile prod up -d` で caddy を起動する際に必須。
# ローカル開発では caddy を起動しないので未設定でよい。
# API_DOMAIN=api.mytechpulse.net
