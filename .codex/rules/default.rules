# このファイルは、Codexがサンドボックス外で実行しようとする禁止操作を止める。
# 引数の位置が変わり得る操作は、PreToolUseフックでも確認する。

prefix_rule(
    pattern = ["git", "push", ["--force", "--force-with-lease", "-f"]],
    decision = "forbidden",
    justification = "履歴の強制上書きは禁止です。新しいコミットで修正してください。",
    match = ["git push --force origin feature/example", "git push -f"],
)

prefix_rule(
    pattern = ["git", "push", "origin", ["main", "HEAD:main"]],
    decision = "forbidden",
    justification = "mainへの直接pushは禁止です。作業ブランチからPRを作成してください。",
    match = ["git push origin main", "git push origin HEAD:main"],
)

prefix_rule(
    pattern = ["gh", "pr", "merge"],
    decision = "forbidden",
    justification = "PRのマージは人間が行います。準備完了を報告してください。",
    match = ["gh pr merge 12 --squash"],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "未保存の変更を失うため禁止です。安全な修正方法を相談してください。",
    match = ["git reset --hard", "git reset --hard HEAD~1"],
)

prefix_rule(
    pattern = ["git", "clean"],
    decision = "forbidden",
    justification = "未追跡ファイルを削除するため禁止です。対象を確認して利用者へ相談してください。",
    match = ["git clean -fd"],
)

prefix_rule(
    pattern = ["docker", "volume", "rm"],
    decision = "forbidden",
    justification = "DBを含む永続データを失うため禁止です。停止だけならdocker compose downを使ってください。",
    match = ["docker volume rm mytechpulse_db"],
)

prefix_rule(
    pattern = ["ssh"],
    decision = "forbidden",
    justification = "本番サーバーへの直接接続は禁止です。公開はCI経由で行ってください。",
    match = ["ssh user@example.com"],
)

prefix_rule(
    pattern = ["wrangler"],
    decision = "forbidden",
    justification = "手動公開は禁止です。公開はmain反映後のCIに任せてください。",
    match = ["wrangler pages deploy dist"],
)

prefix_rule(
    pattern = ["npx", "wrangler"],
    decision = "forbidden",
    justification = "手動公開は禁止です。公開はmain反映後のCIに任せてください。",
    match = ["npx wrangler pages deploy dist"],
)

prefix_rule(
    pattern = ["git", ["commit", "push", "rebase", "merge", "cherry-pick", "revert", "am"], "--no-verify"],
    decision = "forbidden",
    justification = "フックを飛ばす --no-verify は禁止です。通常の git コマンドで、手元の検査を通してください。",
    match = [
        "git commit --no-verify",
        "git commit --no-verify -m msg",
        "git push --no-verify",
        "git rebase --no-verify",
    ],
    not_match = [
        "git commit -m msg",
        "git push -n",
        "git push --dry-run",
        "git log -n 5",
        "git status",
    ],
)

prefix_rule(
    pattern = ["git", "commit", "-n"],
    decision = "forbidden",
    justification = "git commit -n は --no-verify と同じでフックを飛ばすため禁止です。-m でメッセージを付けてコミットしてください。",
    match = [
        "git commit -n",
        "git commit -n -m msg",
    ],
    not_match = [
        "git commit -m msg",
        "git push -n",
        "git log -n 5",
        "git commit -nm msg",
        "git commit -an",
    ],
)

prefix_rule(
    pattern = ["git", "-c", "core.hooksPath"],
    decision = "forbidden",
    justification = "core.hooksPath の上書きはフックを外すため禁止です。有効化は scripts/setup-hooks.sh を使い、値の確認は引数なしの git config core.hooksPath にしてください。",
    match = [
        "git -c core.hooksPath /dev/null status",
        "git -c core.hooksPath true commit",
    ],
    not_match = [
        "git status",
        "git config core.hooksPath",
        "git -c user.name=ada status",
        "git -c core.hooksPath=/dev/null status",
    ],
)
