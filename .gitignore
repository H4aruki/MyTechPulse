# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ===== 仮想環境 =====
venv/
backend/venv/
.venv/
env/

# ===== シークレット / 環境変数 =====
# .env は絶対にコミットしない（.env.example は共有するため除外しない）
.env
backend/.env
*.env
!.env.example
!*.env.example
# 設定を書き換えたときに自動でできる控え（`sed -i.bak` やエディタが作る）。
# 中身は本番の値をそのまま複製したものになるため、本体と同じ扱いで除外する。
# 本体の名前だけを除外していると、`.env.bak` のような派生形が素通りする
*.bak
*.orig
*~

# ===== DBバックアップ（ops/backup_db.sh の生成物） =====
backups/

# ===== OS =====
.DS_Store
Thumbs.db
desktop.ini

# ===== エディタ / IDE =====
.idea/
*.swp
*~

# ===== Claude Code（個人メモ・共有しない） =====
CLAUDE.md

# wrangler pages dev のローカル作業ファイル（Pagesの挙動確認に使う）
.wrangler/

# Playwright MCP のブラウザ操作ログ（動作確認のたびに自動生成される一時ファイル）
.playwright-mcp/
