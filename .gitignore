# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ===== 仮想環境 =====
venv/
backend/venv/
.venv/
env/

# ===== シークレット / 環境変数 =====
# .env は絶対にコミットしない（.env.example は共有するため除外しない）
.env
backend/.env
*.env
!.env.example
!*.env.example
# 設定を書き換えたときに自動でできる控え（`sed -i.bak` やエディタが作る）。
# 中身は本番の値をそのまま複製したものになるため、本体と同じ扱いで除外する。
# 本体の名前だけを除外していると、`.env.bak` のような派生形が素通りする
*.bak
*.orig
*~

# ===== DBバックアップ（ops/backup_db.sh の生成物） =====
backups/

# ===== OS =====
.DS_Store
Thumbs.db
desktop.ini

# ===== エディタ / IDE =====
.idea/
*.swp
*~

# ===== Claude Code =====
# 設定と自動で走る仕掛けは共有する（.claude/settings.json と .claude/hooks/）。
# 各自の好みと、仕掛けが使う作業ファイルだけを外す。
#
# もともとここには CLAUDE.md を共有しない指定があったが、実際には既に
# コミット済みで効いておらず、全員で共有する方針とも逆だったため削除した。
.claude/settings.local.json
.claude/.cache/

# wrangler pages dev のローカル作業ファイル（Pagesの挙動確認に使う）
.wrangler/

# Playwright MCP のブラウザ操作ログ（動作確認のたびに自動生成される一時ファイル）
.playwright-mcp/
