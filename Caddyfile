# 本番APIのHTTPS終端。Go版APIへ中継する。
#
# 証明書は Let's Encrypt から自動取得され、期限が近づくと自動更新される。
# そのため 80番ポートを開けたままにしておく必要がある（HTTP-01チャレンジに使われる）。
# 取得済みの証明書は caddy_data ボリュームに永続化されるので、コンテナを作り直しても
# 取り直しにはならない（Let's Encrypt のレート制限に当たらないための要）。
#
# ドメインはルートの .env の API_DOMAIN で指定する。値が無いと Caddy は起動に失敗する。
# メンテナンス応答（503）にしたいときは、docker-compose.yml の MTP_CADDYFILE で
# ops/caddy/Caddyfile.maintenance を選ぶ。

# グローバル設定は、Caddyfileの先頭に置く決まり
{
	servers {
		# Cloudflareが付けた X-Forwarded-For を信頼し、client_ip を本当の利用者のIPにする。
		# グローバル設定の時点ではスニペットが未定義で使えないため、パスで import する
		import /etc/caddy/cloudflare-trusted-proxies.caddy
	}
}

# Cloudflare経由の要求にだけ答える（#74）。範囲は ops/caddy/cloudflare-ips.caddy（生成物）にあり、
# docker-compose.yml が /etc/caddy/ へ置く。更新は scripts/update-cloudflare-ips.mjs。
import /etc/caddy/cloudflare-ips.caddy

{$API_DOMAIN} {
	# 接続元がCloudflareでない要求は、中継の前に本文なしの403で返す。
	# 証明書のHTTP-01チャレンジ（/.well-known/acme-challenge/）は、Caddy自身がサイトの
	# 各処理より前に応答するので、この403には当たらず、証明書の取得・更新は止まらない。
	import cloudflare_only

	reverse_proxy api-go:8001

	# HTTPSでしか繋がせない。ブラウザは一度アクセスすると以後HTTPを試さなくなる
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}
