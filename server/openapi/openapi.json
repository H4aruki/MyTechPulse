{
  "components": {
    "schemas": {
      "AuthResponse": {
        "additionalProperties": false,
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User",
            "description": "ログインした利用者"
          }
        },
        "required": [
          "user"
        ],
        "type": "object"
      },
      "ClickRequest": {
        "additionalProperties": false,
        "properties": {
          "tags": {
            "description": "クリックした記事タグ。1〜50件、各1〜50文字",
            "items": {
              "type": "string"
            },
            "maxItems": 50,
            "minItems": 1,
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "tags"
        ],
        "type": "object"
      },
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "機械が判定できる安定した業務エラーコード",
            "examples": [
              "invalid_credentials"
            ],
            "type": "string"
          },
          "detail": {
            "description": "今回の問題の説明(利用者向け)",
            "type": "string"
          },
          "errors": {
            "description": "入力項目ごとのエラー",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "instance": {
            "description": "問題の発生箇所を示すURI(使用しない場合は省略)",
            "type": "string"
          },
          "status": {
            "description": "HTTPステータス",
            "examples": [
              401
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "HTTPステータスの短い名前",
            "examples": [
              "Unauthorized"
            ],
            "type": "string"
          },
          "type": {
            "description": "問題の種類を示すURI。固有の種類が無いときはabout:blank",
            "examples": [
              "about:blank"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "type": "object"
      },
      "FeedArticle": {
        "additionalProperties": false,
        "properties": {
          "likes": {
            "description": "いいね数",
            "format": "int64",
            "type": "integer"
          },
          "published_at": {
            "description": "公開日時",
            "format": "date-time",
            "type": "string"
          },
          "source": {
            "description": "記事提供元",
            "enum": [
              "Qiita",
              "Zenn"
            ],
            "type": "string"
          },
          "tags": {
            "description": "記事タグ",
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "title": {
            "description": "記事タイトル",
            "type": "string"
          },
          "url": {
            "description": "記事URL",
            "type": "string"
          }
        },
        "required": [
          "title",
          "url",
          "source",
          "tags",
          "likes",
          "published_at"
        ],
        "type": "object"
      },
      "FeedResponse": {
        "additionalProperties": false,
        "properties": {
          "qiita_articles": {
            "items": {
              "$ref": "#/components/schemas/FeedArticle"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "warnings": {
            "items": {
              "$ref": "#/components/schemas/Warning"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "zenn_articles": {
            "items": {
              "$ref": "#/components/schemas/FeedArticle"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "qiita_articles",
          "zenn_articles",
          "warnings"
        ],
        "type": "object"
      },
      "FieldError": {
        "additionalProperties": false,
        "properties": {
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ],
        "type": "object"
      },
      "LiveOutputBody": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "description": "正常時は常にok",
            "enum": [
              "ok"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "properties": {
          "password": {
            "description": "パスワード",
            "examples": [
              "synthetic-password"
            ],
            "minLength": 1,
            "type": "string"
          },
          "username": {
            "description": "利用者名",
            "examples": [
              "synthetic-user"
            ],
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "type": "object"
      },
      "ReadyOutputBody": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "description": "正常時は常にok",
            "enum": [
              "ok"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "SignupRequest": {
        "additionalProperties": false,
        "properties": {
          "favorite_tags": {
            "description": "興味のあるタグ。1〜128件、各タグは前後の空白を除いて1〜50文字。大文字小文字を無視して重複を除く",
            "examples": [
              [
                "go",
                "react"
              ]
            ],
            "items": {
              "type": "string"
            },
            "maxItems": 128,
            "minItems": 1,
            "type": [
              "array",
              "null"
            ]
          },
          "password": {
            "description": "パスワード。1文字以上、UTF-8で72バイト以内",
            "examples": [
              "synthetic-password"
            ],
            "minLength": 1,
            "type": "string"
          },
          "username": {
            "description": "利用者名。前後の空白を除いて1〜50文字",
            "examples": [
              "synthetic-user"
            ],
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "username",
          "password",
          "favorite_tags"
        ],
        "type": "object"
      },
      "User": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "利用者ID",
            "examples": [
              1
            ],
            "format": "int64",
            "type": "integer"
          },
          "role": {
            "description": "役割。登録時は常にmember",
            "enum": [
              "member",
              "admin"
            ],
            "examples": [
              "member"
            ],
            "type": "string"
          },
          "username": {
            "description": "利用者名",
            "examples": [
              "synthetic-user"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "role"
        ],
        "type": "object"
      },
      "Warning": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "安定した失敗コード",
            "examples": [
              "provider_unavailable"
            ],
            "type": "string"
          },
          "provider": {
            "description": "記事提供元",
            "examples": [
              "qiita"
            ],
            "type": "string"
          }
        },
        "required": [
          "provider",
          "code"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "cookieAuth": {
        "description": "ログインで発行されるHttpOnlyのセッションCookie",
        "in": "cookie",
        "name": "mtp_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "MyTechPulse API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "description": "利用者が存在しない場合と、パスワードが違う場合は、区別できない同じ401を返す。ブラウザからの更新系リクエストには、許可されたOriginと `X-MTP-CSRF: 1` ヘッダーの両方が必要。",
        "operationId": "auth-login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            },
            "description": "OK",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "description": "セッションCookie(HttpOnly、SameSite=Lax)",
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "ログイン",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "description": "現在のセッションだけを失効してCookieを破棄する。セッションが既に無くても204を返す。ブラウザからの更新系リクエストには、許可されたOriginと `X-MTP-CSRF: 1` ヘッダーの両方が必要。",
        "operationId": "auth-logout",
        "responses": {
          "204": {
            "description": "No Content",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "description": "セッションCookieを破棄する指示",
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "ログアウト",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "auth-me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Unauthorized"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "summary": "現在の利用者を取得",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/signup": {
      "post": {
        "description": "利用者を member として登録し、選んだタグを初期の興味として保存して、そのままログイン状態にする。ブラウザからの更新系リクエストには、許可されたOriginと `X-MTP-CSRF: 1` ヘッダーの両方が必要。",
        "operationId": "auth-signup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            },
            "description": "Created",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "description": "セッションCookie(HttpOnly、SameSite=Lax)",
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "会員登録",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/feed": {
      "get": {
        "operationId": "recommendation-feed",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedResponse"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Unauthorized"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "summary": "推薦記事を取得",
        "tags": [
          "recommendation"
        ]
      }
    },
    "/api/v1/feedback/article-clicks": {
      "post": {
        "operationId": "recommendation-clicks",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClickRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "summary": "記事クリックを記録",
        "tags": [
          "recommendation"
        ]
      }
    },
    "/health/live": {
      "get": {
        "operationId": "health-live",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "プロセスの生存確認",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "health-ready",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "DB疎通の確認",
        "tags": [
          "health"
        ]
      }
    }
  }
}
