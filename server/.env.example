# Go製APIの設定。ローカル開発では、このファイルをコピーして server/.env を作る（コピーは Git に入れない）。
# dev.ps1 が server/.env を読み込んで、APIを起動する。
#
# 本番は、このファイルを使わない。サーバー上の ~/mytechpulse-production.env から、
# docker-compose.yml が必要な項目だけを渡す（docs/deploy/lightsail-provisioning.md の7章）。
# 本番の値は、ここにもリポジトリにも書かない。
#
# 起動前に検証される。値が不正だと、APIは起動しない（エラーに入力値は含めない）。

# 実行環境。local / test / production のどれか（既定: local）。
# production にすると、Cookie名が __Host-mtp_session・Secure付きになり、説明ページ(/docs)が閉じる。
APP_ENV=local

# APIの待ち受け先（既定: :8001）。
HTTP_ADDR=:8001

# データベースの接続先。必須。ローカルは docker compose up -d db で起動したDBに繋ぐ。
# 本番は docker-compose.yml が、POSTGRES_PASSWORD から作って渡す。
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/mytechpulse

# Qiita APIのアクセストークン。必須（未設定だと起動しない）。ローカルでは、自分のトークンに置き換える。
QIITA_ACCESS_TOKEN=replace-with-local-token

# ブラウザからの通信を許す画面のURL。カンマ区切り。「*」とパス付きのURLは使えない（既定: http://localhost:5173）。
# 本番は、画面の公開URL（例: https://mytechpulse.net）と完全に一致させる。
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ログインの有効期間（既定: 24h）。0より大きい期間で指定する。本番では、いまは既定のまま。
SESSION_TTL=24h

# QiitaとZennへの1回の問い合わせの待ち時間（既定: 5s）。
PROVIDER_TIMEOUT=5s

# 記事一覧の取得全体の待ち時間（既定: 8s）。
FEED_TIMEOUT=8s

# 1回の応答として受け取る最大のバイト数（既定: 2097152 = 約2MB）。
PROVIDER_MAX_BYTES=2097152

# 自動生成のAPI説明ページ(/docs)を出すか。local/testの既定は true。
# production では true にできない（起動に失敗する）。
SWAGGER_ENABLED=true
